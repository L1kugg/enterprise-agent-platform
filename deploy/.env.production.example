# ============================================================
# Enterprise Agent Platform 生产环境变量模板
# 用法：cp .env.production.example .env.production && vi .env.production
# 安全：本文件含敏感信息，已进 .gitignore，切勿提交或外传
# 随机串生成：openssl rand -hex 32
# ============================================================

# ----- 数据库（MySQL）-----
# MySQL root 密码，必填
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ----- AI 模型（阿里云 DashScope，OpenAI 兼容模式）-----
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# ----- 认证与安全 -----
# JWT 签名密钥，必填，至少 32 字节随机串
APP_JWT_SECRET=replace_with_openssl_rand_hex_32_bytes
APP_JWT_EXPIRE_MINUTES=120
APP_JWT_REFRESH_EXPIRE_DAYS=14
APP_API_KEY_EXPIRE_DAYS=30
# 管理员引导密钥，必填（自定义字符串，如 sk-admin- + 随机串）。
# 仓库内置演示 key 已被 Flyway V15 吊销，必须自设；首次启动自动注入为 ADMIN 凭据
APP_BOOTSTRAP_API_KEY=sk-admin-replace_me
# 前端实际访问地址（协议/域名/端口必须完全一致），如 http://服务器IP:8088
APP_CORS_ALLOWED_ORIGINS=http://localhost:8088

# ----- pgvector 向量库 -----
APP_PGVECTOR_USERNAME=pgvector
APP_PGVECTOR_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ----- RabbitMQ 消息队列 -----
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ----- 接口限流（可选，按需调整）-----
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_CAPACITY=100
APP_RATE_LIMIT_REFILL_TOKENS=100
APP_RATE_LIMIT_REFILL_SECONDS=60

# ----- 模型路由（可选，默认即可）-----
APP_MODEL_ROUTER_ENABLED=true
APP_MODEL_ROUTER_DEFAULT_PROFILE=balanced
APP_MODEL_ROUTER_CHAT_PROFILE=balanced
APP_MODEL_ROUTER_SERVICE_PROFILE=quality
APP_MODEL_ROUTER_RAG_PROFILE=balanced
APP_MODEL_ROUTER_MODEL_ECONOMY=qwen-turbo
APP_MODEL_ROUTER_MODEL_BALANCED=qwen-plus
APP_MODEL_ROUTER_MODEL_QUALITY=qwen-max

# ----- 可观测性与审计（可选）-----
OTEL_SAMPLING_PROBABILITY=0.1
APP_AUDIT_RETENTION_DAYS=90
